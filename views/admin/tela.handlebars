<h2>Painel Administrativo</h2>

<h3>Contas cadastradas</h3>

<table>

    <thead>

        <tr>

            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Tipo</th>
            <th>Livros</th>

        </tr>

    </thead>

    <tbody>

        {{#each usuarios}}

        <tr>

            <td>
                {{this.id}}
            </td>

            <td>
                {{this.nome}}
            </td>

            <td>
                {{this.email}}
            </td>

            <td>
                {{this.tipo}}
            </td>

            <td>
                {{this.livros.length}}
            </td>

        </tr>

        {{/each}}

    </tbody>

</table>


<h3>Livros doados</h3>

<table>

    <thead>

        <tr>

            <th>Livro</th>
            <th>Autor</th>
            <th>Doador</th>
            <th>Status</th>

        </tr>

    </thead>

    <tbody>

        {{#each livros}}

        <tr>

            <td>
                {{this.titulo}}
            </td>

            <td>
                {{this.autor}}
            </td>

            <td>
                {{this.usuario.nome}}
            </td>

            <td>

                <span class="status {{this.status}}">
                    {{this.status}}
                </span>

            </td>

        </tr>

        {{/each}}

    </tbody>

</table>